<?xml version="1.0" encoding="utf-8"?>
<!--
  跟随系统 · 系统浅色：太阳 + 中央以 evenOdd 挖空的字母 A（A 透明反白）。
  由 lightmode-a.svg 转来：八道光线 + 中央圆盘 r=6.5，A 作为同路径的子路径挖空。
  单 tint 着色（fillColor 写死黑色，Icon 用 tint 覆盖）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 8 道光线：2px 圆头描边，视觉半径 7.5 → 11（SVG 的 rotate 已预计算为绝对坐标） -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M20.5,12 L22,12 M18.01,18.01 L19.07,19.07 M12,20.5 L12,22 M5.99,18.01 L4.93,19.07 M3.5,12 L2,12 M5.99,5.99 L4.93,4.93 M12,3.5 L12,2 M18.01,5.99 L19.07,4.93" />

    <!-- 中央圆盘 r=6.5，与字母 A 子路径一起用 evenOdd 把 A 挖空 -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M12,5.5 A6.5,6.5 0 0 1 18.5,12 A6.5,6.5 0 0 1 12,18.5 A6.5,6.5 0 0 1 5.5,12 A6.5,6.5 0 0 1 12,5.5 Z M11.5,9.1 h1 l1.95,5.8 h-1.3 l-0.47,-1.4 h-1.36 l-0.47,1.4 h-1.3 Z m0.12,3.5 h0.76 L12,11.48 Z" />
</vector>
